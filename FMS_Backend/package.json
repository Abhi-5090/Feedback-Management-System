{
  "name": "fms-backend",
  "version": "1.0.0",
  "description": "Feedback Management System \u2014 Express + Mongoose API",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/seed.js",
    "test": "cross-env NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --forceExit",
    "import:schedule": "node src/scripts/import-schedule.js",
    "migrate": "node src/scripts/migrate-mentor-rosters.js",
    "test:ci": "cross-env NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --forceExit --ci --coverage",
    "db:reset": "node src/scripts/reset-and-import.js",
    "loadtest": "node src/scripts/loadtest-cohort.js",
    "start:cluster": "node src/cluster.js",
    "reconcile": "node src/scripts/reconcile-counters.js",
    "audit:policy": "node ../scripts/check-audit.mjs",
    "test:coverage": "cross-env NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --forceExit --coverage"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testMatch": [
      "**/src/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/tests/**",
      "!src/scripts/**",
      "!src/seed.js",
      "!src/cluster.js",
      "!src/server.js"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 68,
        "branches": 53,
        "functions": 74,
        "lines": 71
      }
    }
  },
  "dependencies": {
    "@sentry/node": "^10.76.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "nodemailer": "^10.0.13",
    "pdfmake": "^0.2.10",
    "pino": "^10.4.0",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
