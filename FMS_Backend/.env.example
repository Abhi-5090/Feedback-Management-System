# ── Server ────────────────────────────────────────────────────────────────
PORT=5555
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────
# NEVER put real credentials in this file — it is COMMITTED TO GIT.
# Copy it to `.env` (gitignored) and put your real URI there.
#
# Multi-document transactions require a replica set. The API probes support on
# connect and degrades to ordered writes (guarded by the DeviceLock unique
# index) on a standalone, so both work — a replica set is just stronger.
#
#   local replica set : mongodb://127.0.0.1:27017/fms?replicaSet=rs0
#   local standalone  : mongodb://127.0.0.1:27017/fms
#   Atlas             : mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/fms?replicaSet=rs0

# ── Auth / crypto ─────────────────────────────────────────────────────────
# REQUIRED in production: with NODE_ENV=production the server REFUSES to boot if
# these are missing, shorter than 32 chars, or contain a placeholder like
# "change_me". Generate strong values: `openssl rand -hex 32`.
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d
# Salt mixed into device-signature hashes (Layer 2 anti-duplicate).
# KEEP THIS STABLE. Every DeviceLock row is sha256(batchId + cookieToken +
# fingerprint + this salt). Change it and every existing lock stops matching, so
# students who already submitted could submit again on a still-open batch.
DEVICE_SALT=change_me_to_another_long_random_secret

# Whether auth/device cookies get the `Secure` flag. Defaults to on when
# NODE_ENV=production. Set to "false" ONLY for a plain-HTTP demo, where a Secure
# cookie would be silently dropped by the browser.
# COOKIE_SECURE=true

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated allowlist of frontend origins.
CLIENT_ORIGINS=http://localhost:5173

# ── App identity ──────────────────────────────────────────────────────────
APP_NAME=Feedback Management
# Public URL of the SPA — used to build links inside emails.
# Defaults to the first CLIENT_ORIGINS entry.
APP_URL=http://localhost:5173

# ── Rate limiting ─────────────────────────────────────────────────────────
# The student endpoints are keyed on the per-device cookie (falling back to IP),
# so a whole classroom behind ONE campus NAT is not throttled as a single
# client. These are per-device budgets; PUBLIC_IP_MAX is the wider per-IP
# backstop that still blunts a scripted flood.
PUBLIC_MAX_PER_DEVICE=20
PUBLIC_IP_MAX=5000
# Mongo connection pool ceiling. Atlas shared tiers cap the CLUSTER at 500
# connections across every app instance, so raise this deliberately.
MONGO_MAX_POOL_SIZE=150
# Login attempts are keyed on email+IP so one person fat-fingering their
# password cannot lock out everyone else on the same network.
LOGIN_MAX_PER_IDENTITY=20
LOGIN_IP_MAX=300

# ── Email (welcome mail + password reset + digests) ───────────────────────
# LEAVE BLANK IN DEVELOPMENT: with no SMTP host the mailer prints each message
# — including the reset link — to the server console, so the whole flow works
# with zero setup. Fill these in for production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Feedback Management <no-reply@example.com>

# How long a password-reset link stays valid (minutes).
RESET_TOKEN_MINUTES=30

# Master switch for the scheduled email digest.
DIGESTS_ENABLED=true

# ── Seed admin (used by `npm run seed`) ───────────────────────────────────
# Both ADMIN_* and SEED_ADMIN_* are accepted; ADMIN_* wins if both are set.
ADMIN_EMAIL=admin@example.com
# Leave blank to auto-generate a strong password (printed once on seed).
ADMIN_PASSWORD=
