# Public path the app is served under. Leave blank/unset for a root deploy.
# Set it (WITH both slashes, e.g. /fms/) when nginx mounts the SPA on a
# sub-path: vite's `base` and the React Router basename both derive from it, and
# without it every asset is requested from the domain root and the page renders
# blank. Pair it with VITE_API_URL below (e.g. /fms) so the API stays
# same-origin and the auth cookie stays first-party.
VITE_BASE_PATH=

# Backend origin used by the dev proxy (see vite.config.js).
# MUST match PORT in FMS_Backend/.env. If these disagree, the vite proxy can't
# reach the API and the browser shows a confusing "status code 500".
VITE_API_PROXY=http://localhost:5555
# If you call the API cross-origin instead of via the proxy, set this and the
# axios client will use it as baseURL. Leave blank to use same-origin "/api".
VITE_API_URL=
