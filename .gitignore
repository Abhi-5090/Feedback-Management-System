# Dependencies
node_modules/
**/node_modules/

# Environment / secrets — never commit real values (use .env.example).
# The broad `.env*` rule catches .env.local, .env.production, .env.backup and
# any other suffix someone invents; .env.example is re-allowed explicitly
# because it is the documented template and must stay tracked.
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
*.pem
*.key

# Build output
dist/
**/dist/
build/
**/build/
coverage/
**/coverage/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Misc
.cache/
tmp/

# Database backups written by reset-and-import.js (contain password hashes)
backups/
**/backups/
